# Backend authentication and run settings
AUTH_SECRET=replace-with-a-long-random-signing-secret
AUTH_TOKEN_MAX_AGE=3600
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-for-local-use
AI_AGENTS_PACKAGE_PATH=packages/ai_agents
RUN_TIMEOUT_SECONDS=900

# AI Agents CLI-only examples. API runs send these in request input.
WEBSITE_URL=http://localhost:3000/login
TEST_USERNAME=test-user
TEST_PASSWORD=replace-for-local-use
ANTHROPIC_API_KEY=
HEADLESS=1
ALLOW_DESTRUCTIVE=0
TEST_ROUTES=/dashboard
